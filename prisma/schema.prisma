generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum InstagramAccountStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum InstagramProviderType {
  MOCK
  META
}

enum WebhookProvider {
  META
  MOCK
}

enum WebhookEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

enum PublicationStatus {
  DRAFT
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELED
}

enum PublicationMediaType {
  PHOTO
  VIDEO
  REEL
}

enum MediaStorageType {
  LOCAL
  S3
}

enum AutomationTriggerType {
  COMMENT_RECEIVED
  MESSAGE_RECEIVED
  WEBHOOK_EVENT_RECEIVED
}

enum AutomationExecutionStatus {
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

enum AutomationActionType {
  REGISTER_EVENT
  SEND_MESSAGE
  REPLY_COMMENT
  TAG_CONTACT
  NOTIFY_OPERATOR
}

enum AutomationActionStatus {
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique @db.VarChar(320)
  passwordHash         String                @map("password_hash") @db.VarChar(255)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          Membership[]
  refreshTokens        RefreshToken[]
  instagramOAuthStates InstagramOAuthState[]

  @@map("users")
}

model Organization {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(120)
  slug                 String                @unique @db.VarChar(140)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          Membership[]
  refreshTokens        RefreshToken[]
  instagramAccounts    InstagramAccount[]
  instagramOAuthStates InstagramOAuthState[]
  publications         Publication[]
  mediaAssets          MediaAsset[]
  automationRules      AutomationRule[]
  automationExecutions AutomationExecution[]
  automationContactTags AutomationContactTag[]
  automationNotifications AutomationNotification[]

  @@map("organizations")
}

model InstagramAccount {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  provider             InstagramProviderType
  externalAccountId    String?                @map("external_account_id") @db.VarChar(255)
  username             String?                @db.VarChar(100)
  name                 String?                @db.VarChar(150)
  avatarUrl            String?                @map("avatar_url") @db.Text
  status               InstagramAccountStatus @default(CONNECTING)
  encryptedAccessToken String?                @map("encrypted_access_token") @db.Text
  accessTokenIv        String?                @map("access_token_iv") @db.VarChar(32)
  accessTokenTag       String?                @map("access_token_tag") @db.VarChar(32)
  tokenExpiresAt       DateTime?              @map("token_expires_at") @db.Timestamptz(3)
  connectedAt          DateTime?              @map("connected_at") @db.Timestamptz(3)
  disconnectedAt       DateTime?              @map("disconnected_at") @db.Timestamptz(3)
  lastSyncedAt         DateTime?              @map("last_synced_at") @db.Timestamptz(3)
  lastError            String?                @map("last_error") @db.VarChar(500)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthStates          InstagramOAuthState[]
  publications         Publication[]
  automationRules      AutomationRule[]
  automationExecutions AutomationExecution[]
  automationContactTags AutomationContactTag[]
  automationNotifications AutomationNotification[]

  @@unique([organizationId, id])
  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId, status])
  @@map("instagram_accounts")
}

model InstagramOAuthState {
  id             String           @id @default(uuid()) @db.Uuid
  stateHash      String           @unique @map("state_hash") @db.Char(64)
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@map("instagram_oauth_states")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model RefreshToken {
  id                String       @id @default(uuid()) @db.Uuid
  tokenHash         String       @unique @map("token_hash") @db.Char(64)
  userId            String       @map("user_id") @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?      @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model WebhookEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  provider            WebhookProvider
  externalEventId     String?            @map("external_event_id") @db.VarChar(255)
  dedupeKey           String             @unique @map("dedupe_key") @db.Char(64)
  eventType           String             @map("event_type") @db.VarChar(120)
  normalizedPayload   Json               @map("normalized_payload")
  rawPayload          Json?              @map("raw_payload")
  receivedAt          DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt         DateTime?          @map("processed_at") @db.Timestamptz(3)
  processingStartedAt DateTime?          @map("processing_started_at") @db.Timestamptz(3)
  status              WebhookEventStatus @default(RECEIVED)
  error               String?            @db.VarChar(500)
  processingAttempts  Int                @default(0) @map("processing_attempts")

  @@unique([provider, externalEventId])
  @@index([provider, status, receivedAt])
  automationExecutions AutomationExecution[]
  automationNotifications AutomationNotification[]
  @@map("webhook_events")
}

model Publication {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  instagramAccountId  String               @map("instagram_account_id") @db.Uuid
  idempotencyKey      String?              @map("idempotency_key") @db.VarChar(128)
  mediaType           PublicationMediaType @map("media_type")
  mediaUrl            String?              @map("media_url") @db.Text
  mediaAssetId        String?              @map("media_asset_id") @db.Uuid
  caption             String?              @db.VarChar(2200)
  altText             String?              @map("alt_text") @db.VarChar(1000)
  shareToFeed         Boolean?             @map("share_to_feed")
  status              PublicationStatus    @default(DRAFT)
  externalContainerId String?              @map("external_container_id") @db.VarChar(255)
  externalMediaId     String?              @map("external_media_id") @db.VarChar(255)
  errorCode           String?              @map("error_code") @db.VarChar(100)
  errorMessage        String?              @map("error_message") @db.VarChar(500)
  attemptCount        Int                  @default(0) @map("attempt_count")
  queuedAt            DateTime?            @map("queued_at") @db.Timestamptz(3)
  scheduledAt         DateTime?            @map("scheduled_at") @db.Timestamptz(3)
  scheduleTimezone    String?              @map("schedule_timezone") @db.VarChar(64)
  processingStartedAt DateTime?            @map("processing_started_at") @db.Timestamptz(3)
  publishAttemptedAt  DateTime?            @map("publish_attempted_at") @db.Timestamptz(3)
  publishedAt         DateTime?            @map("published_at") @db.Timestamptz(3)
  canceledAt          DateTime?            @map("canceled_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount    InstagramAccount     @relation(fields: [organizationId, instagramAccountId], references: [organizationId, id], onDelete: Cascade)
  mediaAsset          MediaAsset?           @relation(fields: [organizationId, mediaAssetId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, scheduledAt])
  @@index([instagramAccountId, createdAt])
  @@index([mediaAssetId])
  @@map("publications")
}

model MediaAsset {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  storageType      MediaStorageType @default(LOCAL) @map("storage_type")
  storageKey       String           @map("storage_key") @db.VarChar(1024)
  originalFileName String           @map("original_file_name") @db.VarChar(255)
  mimeType         String           @map("mime_type") @db.VarChar(100)
  mediaKind        String           @map("media_kind") @db.VarChar(16)
  sizeBytes        Int              @map("size_bytes")
  sha256           String           @db.Char(64)
  width            Int?
  height           Int?
  metadata         Json
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publications     Publication[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, sha256])
  @@index([organizationId, originalFileName])
  @@map("media_assets")
}

model AutomationRule {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  instagramAccountId String                @map("instagram_account_id") @db.Uuid
  name               String                @db.VarChar(120)
  active             Boolean               @default(true)
  triggerType        AutomationTriggerType @map("trigger_type")
  conditions         Json
  actions            Json
  deletedAt          DateTime?             @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount      @relation(fields: [organizationId, instagramAccountId], references: [organizationId, id], onDelete: Cascade)
  executions         AutomationExecution[]
  contactTags        AutomationContactTag[]
  notifications      AutomationNotification[]

  @@unique([organizationId, id])
  @@index([organizationId, instagramAccountId, active, deletedAt])
  @@map("automation_rules")
}

model AutomationExecution {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  instagramAccountId String                    @map("instagram_account_id") @db.Uuid
  automationRuleId   String                    @map("automation_rule_id") @db.Uuid
  webhookEventId     String                    @map("webhook_event_id") @db.Uuid
  status             AutomationExecutionStatus @default(PROCESSING)
  result             Json?
  errorCode          String?                   @map("error_code") @db.VarChar(100)
  startedAt          DateTime                  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?                 @map("finished_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount          @relation(fields: [organizationId, instagramAccountId], references: [organizationId, id], onDelete: Cascade)
  automationRule     AutomationRule            @relation(fields: [organizationId, automationRuleId], references: [organizationId, id], onDelete: Cascade)
  webhookEvent       WebhookEvent               @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  actionExecutions   AutomationActionExecution[]

  @@unique([organizationId, automationRuleId, webhookEventId])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("automation_executions")
}

model AutomationActionExecution {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  automationExecutionId String                @map("automation_execution_id") @db.Uuid
  actionIndex           Int                   @map("action_index")
  actionType            AutomationActionType  @map("action_type")
  status                AutomationActionStatus @default(PROCESSING)
  idempotencyKey        String                @unique @map("idempotency_key") @db.Char(64)
  effectKey             String?               @unique @map("effect_key") @db.Char(64)
  result                Json?
  errorCode             String?               @map("error_code") @db.VarChar(100)
  startedAt             DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt            DateTime?             @map("finished_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  automationExecution   AutomationExecution   @relation(fields: [organizationId, automationExecutionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([automationExecutionId, actionIndex])
  @@index([organizationId, status, createdAt])
  @@map("automation_action_executions")
}

model AutomationContactTag {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  instagramAccountId String           @map("instagram_account_id") @db.Uuid
  automationRuleId   String           @map("automation_rule_id") @db.Uuid
  externalContactId  String           @map("external_contact_id") @db.VarChar(255)
  tag                String           @db.VarChar(64)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount @relation(fields: [organizationId, instagramAccountId], references: [organizationId, id], onDelete: Cascade)
  automationRule     AutomationRule   @relation(fields: [organizationId, automationRuleId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, instagramAccountId, externalContactId, tag])
  @@index([organizationId, externalContactId])
  @@map("automation_contact_tags")
}

model AutomationNotification {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  instagramAccountId String           @map("instagram_account_id") @db.Uuid
  automationRuleId   String           @map("automation_rule_id") @db.Uuid
  webhookEventId     String           @map("webhook_event_id") @db.Uuid
  actionIndex        Int               @map("action_index")
  message            String            @db.VarChar(500)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt             DateTime?         @map("read_at") @db.Timestamptz(3)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount  @relation(fields: [organizationId, instagramAccountId], references: [organizationId, id], onDelete: Cascade)
  automationRule     AutomationRule    @relation(fields: [organizationId, automationRuleId], references: [organizationId, id], onDelete: Cascade)
  webhookEvent       WebhookEvent      @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)

  @@unique([automationRuleId, webhookEventId, actionIndex])
  @@index([organizationId, readAt, createdAt])
  @@map("automation_notifications")
}
