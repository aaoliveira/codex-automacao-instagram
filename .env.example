NODE_ENV=development
PORT=3001
API_PORT=3001
DATABASE_URL=postgresql://app:app@localhost:5432/instagram_automation?schema=public
REDIS_URL=redis://localhost:6379
# Keep development workers conservative; increase per domain when capacity allows.
PUBLICATION_WORKER_CONCURRENCY=1
WEBHOOK_WORKER_CONCURRENCY=1
AUTOMATION_WORKER_CONCURRENCY=1
PUBLICATION_MAX_ATTEMPTS=3
PUBLICATION_RETRY_DELAY_MS=2000
PUBLICATION_ORGANIZATION_RATE_LIMIT_MAX=20
PUBLICATION_ACCOUNT_RATE_LIMIT_MAX=5
PUBLICATION_RATE_LIMIT_WINDOW_MS=60000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=365
WEBHOOK_EVENT_RETENTION_DAYS=365
RETENTION_CLEANUP_INTERVAL_MS=86400000
INSTAGRAM_PROVIDER=MOCK
# Initial per-organization quotas; existing organization quotas are stored in PostgreSQL and can be managed by OWNER/ADMIN.
INSTAGRAM_DEFAULT_ORGANIZATION_ACCOUNT_LIMIT=10
INSTAGRAM_DEFAULT_ORGANIZATION_GROUP_LIMIT=20
# Local development only. Use a fresh random 32-byte key stored in a secret manager in production.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/instagram/oauth/callback
# Required only when INSTAGRAM_PROVIDER=META; set to the current version enabled for your Meta app.
META_INSTAGRAM_GRAPH_API_VERSION=
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_messages
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
WEBHOOK_STORE_RAW_PAYLOAD=false
# Media uploads default to local disk for development. S3 uses the AWS SDK default credential chain.
MEDIA_STORAGE_PROVIDER=LOCAL
MEDIA_LOCAL_ROOT=./var/media
MEDIA_PUBLIC_API_URL=http://localhost:3001
MEDIA_MAX_FILE_SIZE_BYTES=104857600
MEDIA_SIGNED_URL_TTL_SECONDS=3600
MEDIA_ORPHAN_GRACE_HOURS=24
MEDIA_URL_SIGNING_SECRET=replace-with-at-least-32-random-characters
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SEED_EMAIL=owner@example.com
SEED_PASSWORD=local-dev-only-change-this-password
SEED_ORGANIZATION=Development Workspace
